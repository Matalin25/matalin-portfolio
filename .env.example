# --- Общие настройки --------------------------------------------------------
# APP_ENV: development | production
APP_ENV=development
SITE_DOMAIN=matalin-portfolio.ru
BASE_URL=https://matalin-portfolio.ru

# --- Контакты (ЗАМЕНИТЕ на реальные) ----------------------------------------
TELEGRAM_USERNAME=matalin_dev
TELEGRAM_DISPLAY=@matalin_dev
EMAIL=hello@matalin-portfolio.ru
GITHUB_URL=https://github.com/matalin-dev

# --- Безопасность -----------------------------------------------------------
# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Пароль админ-панели. Если пусто — будет сгенерирован в data/admin_secret.txt
ADMIN_PASSWORD=
ADMIN_USER=admin
# Включить Secure у cookie (только при HTTPS)
SESSION_COOKIE_SECURE=false
# Доверять X-Forwarded-Proto (когда сайт за Nginx или балансировщиком)
TRUST_PROXY_SSL=false
# Принудительные редиректы (только для production)
FORCE_HTTPS=false
FORCE_WWW_REDIRECT=false

# --- Лимиты формы обратной связи --------------------------------------------
RATE_LIMIT_WINDOW=600
RATE_LIMIT_MAX=5

# --- Уведомления в Telegram (необязательно) ---------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Пути к каталогам (необязательно, по умолчанию рядом с проектом) --------
# DATA_DIR=data
# LOG_DIR=logs
# BACKUP_DIR=backups
